# Vorlage für die .env-Datei.
# Kopieren nach .env und die Werte anpassen:
#     cp .env.example .env        (Linux/Mac)
#     copy .env.example .env      (Windows cmd)
# Die echte .env ist per .gitignore ausgeschlossen und wird NICHT eingecheckt.

# Modellwahl des Backend-Agenten:
#   LOCAL=true  -> lokales Ollama-Modell (LOCAL_BASE_URL / LOCAL_MODEL_NAME)
#   LOCAL=false -> Nvidia-NIM-Cloud-API (NVIDIA_API_KEY nötig)
LOCAL=true

# API-Schlüssel für die Nvidia-NIM-API (nur nötig, wenn LOCAL=false).
# Schlüssel erstellen unter: https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-...

# Ollama-Server (genutzt, wenn LOCAL=true). Standardmäßig lokal auf Port 11434.
# Für ein Modell auf einem ANDEREN Gerät die IP eintragen, z. B.:
#   LOCAL_BASE_URL=http://192.168.1.50:11434
# (Dort muss Ollama mit OLLAMA_HOST=0.0.0.0:11434 lauschen und Port 11434 offen sein.)
LOCAL_BASE_URL=http://localhost:11434

# Name des per Ollama bereitgestellten Modells (muss dort gepullt sein).
# Vorher laden, z. B.:  ollama pull llama3.2:3b
LOCAL_MODEL_NAME=llama3.2:3b

# Ollama-Modell beim API-Start vorladen und beim Stop entladen (optional).
#   true  -> Modell wird beim Start in den RAM geladen (schnellere erste Antwort)
#   false -> kein Vorladen/Entladen
# Nur relevant, wenn LOCAL=true.
OLLAMA_WARMUP=true

# HuggingFace/Transformers offline: alle HF-Modelle (docling, Embedding-Modell und
# ggf. kuenftige Chunking-Modelle) laden ausschliesslich aus dem lokalen Cache –
# keine Anfragen an den HF Hub, keine "unauthenticated requests"-Warnung, kein Netz.
#   1 = offline (Standard, empfohlen)
#   0 = online (nur noetig, um einmalig ein noch nicht gecachtes Modell zu laden)
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# Gemeinsames Embedding-Modell fuer ALLE Chunking-Methoden (recursive, markdown,
# semantic, late). Ein einziger Vektorraum -> die Retrieval-Distanzen sind ueber alle
# Methoden vergleichbar (faire, gemeinsame Schwelle). Mehrsprachig + Langkontext.
# Beim ERSTEN Einsatz einmalig mit HF_HUB_OFFLINE=0 laden.
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# Late Chunking (ChunkingMethod.LATE, via Chonkie): eigenes Embedding-Modell, weil
# hier der GANZE Text zuerst embeddet wird -> es braucht ein LANG-Kontext- und (fuer
# deutsches Material) MEHRSPRACHIGES Modell. Das Standard-128-Token-Modell reicht NICHT.
# Beim ERSTEN Einsatz einmalig mit HF_HUB_OFFLINE=0 laden.
#   Empfehlung mehrsprachig: intfloat/multilingual-e5-base (512 Tokens)
#   Lang-Kontext:            jinaai/jina-embeddings-v3   (8192 Tokens, groesser)
LATE_EMBEDDING_MODEL=intfloat/multilingual-e5-base
# Chunk-Groesse (Tokens) fuer Late Chunking.
LATE_CHUNK_SIZE=512

# Retrieval-Modus des Agenten:
#   false -> feste Anzahl der aehnlichsten Chunks (Top-n, Standard)
#   true  -> alle Chunks unter einer Distanz-Schwelle (dynamisch)
DYNAMIC_RETREIVAL=false

# Debug-Ausgaben (z. B. die im Retrieval gefundenen Chunks) in der Server-Konsole.
#   true -> an, false -> aus (Standard).
DEBUG=false
